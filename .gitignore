# Ignore everything at root by default except backend, frontend, README, and .gitignore
/*
!/backend/
!/frontend/
!/README.md
!/.gitignore

# Documents and specifications
*.docx
*.pdf

# Extra root files, scripts and legacy launchers
claudechat*
docs/
documents/
.github/
package.json
docker-compose.yml
render.yaml
run.sh
run_windows.bat
DEPLOY.md
LICENSE

# Backend specifics
backend/claudechat*
backend/ai_news_summary.txt
backend/.venv/
backend/.pytest_cache/
backend/__pycache__/
backend/data/
data/

# Frontend specifics
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/public/generated_docs/
frontend/isro_2026_mission_roadmap.md
frontend/.vercel/

# Node modules & locks
node_modules/
package-lock.json

# Environment variables
.env
.env.local
.env.*.local
*.env

# OS and logs
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.claude/
*.tsbuildinfo
coverage/
jest-test-results.json
.vscode/
.idea/
turbo/
# Generated audio
*.mp3
*.wav
